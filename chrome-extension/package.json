{
  "name": "carmodpicker-chrome-extension",
  "version": "1.0.0",
  "description": "CarModPicker browser companion extension",
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production vite build && node scripts/inline-content.js",
    "build:dev": "vite build && node scripts/inline-content.js",
    "watch": "vite build --watch",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
