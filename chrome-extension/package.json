{
  "name": "carmodpicker-chrome-extension",
  "version": "1.0.0",
  "description": "CarModPicker browser companion extension",
  "type": "module",
  "scripts": {
    "build": "NODE_ENV=production vite build && node scripts/inline-content.js",
    "build:dev": "vite build && node scripts/inline-content.js",
    "watch": "vite build --watch",
    "dev": "vite build --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.9",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "canvas": "^3.2.3",
    "sharp": "^0.35.3",
    "typescript": "~7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
