    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/chrome": "^0.1.43",
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react-swc": "^4.3.0",
    "canvas": "^3.2.3",
    "sharp": "^0.35.1",
    "typescript": "~5.8.3",
    "vite": "^6.4.2"
  }
