{
  "manifest_version": 3,
  "name": "CarModPicker Browser Companion",
  "version": "1.1.18",
  "description": "Pull in part information from any product page and add it to CarModPicker",
  "homepage_url": "https://carmodpicker.com",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://api.carmodpicker.com/*",
    "https://api.staging.carmodpicker.com/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://carmodpicker.com/*",
        "*://*.carmodpicker.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": [
      "*://carmodpicker.com/*",
      "*://*.carmodpicker.com/*",
      "http://localhost/*",
      "http://localhost:4000/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "auth-callback.html"
      ],
      "matches": [
        "https://carmodpicker.com/*",
        "https://*.carmodpicker.com/*",
        "http://localhost/*"
      ]
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
