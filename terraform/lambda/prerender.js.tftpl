'use strict';

// Token is substituted at plan time via Terraform templatefile(). Lambda@Edge
// does not support environment variables, so the value must live in the code.
var PRERENDER_TOKEN = '${prerender_token}';
var PRERENDER_HOST = 'service.prerender.io';

var BOT_PATTERN = new RegExp(
  [
    'googlebot',
    'bingbot',
    'yandex',
    'baiduspider',
    'duckduckbot',
    'mediapartners-google',
    'adsbot-google',
    'google-adwords',
    'twitterbot',
    'facebookexternalhit',
    'rogerbot',
    'linkedinbot',
    'embedly',
    'quora link preview',
    'showyoubot',
    'outbrain',
    'pinterest',
    'slackbot',
    'vkshare',
    'w3c_validator',
    'redditbot',
    'applebot',
    'whatsapp',
    'flipboard',
    'tumblr',
    'bitlybot',
    'skypeuripreview',
    'nuzzel',
    'discordbot',
    'google page speed',
    'qwantify',
    'bitrix link preview',
    'xing-contenttabreceiver',
    'chrome-lighthouse',
    'telegrambot',
    'ia_archiver',
    'gptbot',
    'chatgpt-user',
    'claudebot',
    'ccbot',
    'perplexitybot',
    'yeti',
    'mj12bot',
    'semrushbot',
    'ahrefsbot',
    'screaming frog',
    'phantomjs'
  ].join('|'),
  'i'
);

var EXT_PATTERN = /\.(js|css|xml|less|png|jpg|jpeg|gif|pdf|doc|txt|ico|rss|zip|mp3|rar|exe|wmv|avi|ppt|mpg|mpeg|tif|wav|mov|psd|ai|xls|mp4|m4a|swf|dat|dmg|iso|flv|m4v|torrent|woff|woff2|ttf|svg|webmanifest|map|json)$/i;

function firstHeader(headers, key) {
  var entry = headers[key.toLowerCase()];
  return entry && entry[0] ? entry[0].value : '';
}

function isBotRequest(request) {
  var ua = firstHeader(request.headers, 'user-agent');
  if (!ua) return false;
  if (!BOT_PATTERN.test(ua)) return false;
  var uri = (request.uri || '/').toLowerCase();
  if (EXT_PATTERN.test(uri)) return false;
  return true;
}

// viewer-request: tag the request with a single-byte header so the CloudFront
// cache key partitions bot vs. human responses. We do NOT rewrite the origin
// here — CloudFront only honors origin changes in origin-request.
function handleViewerRequest(request) {
  var treatAsBot = PRERENDER_TOKEN && isBotRequest(request);
  request.headers['cloudfront-is-bot'] = [
    { key: 'CloudFront-Is-Bot', value: treatAsBot ? '1' : '0' }
  ];
  return request;
}

// origin-request: if the viewer-request trigger flagged this as a bot, swap
// the origin to prerender.io, which proxies the URL, runs a headless browser,
// and returns the rendered HTML.
function handleOriginRequest(request) {
  var isBotHeader = firstHeader(request.headers, 'cloudfront-is-bot');
  if (!PRERENDER_TOKEN || isBotHeader !== '1') {
    return request;
  }

  var host = firstHeader(request.headers, 'host') || 'www.carmodpicker.com';
  var qs = request.querystring ? '?' + request.querystring : '';
  var targetUrl = 'https://' + host + request.uri + qs;

  request.origin = {
    custom: {
      domainName: PRERENDER_HOST,
      port: 443,
      protocol: 'https',
      path: '',
      sslProtocols: ['TLSv1.2'],
      readTimeout: 30,
      keepaliveTimeout: 5,
      customHeaders: {
        'x-prerender-token': [
          { key: 'X-Prerender-Token', value: PRERENDER_TOKEN }
        ]
      }
    }
  };
  request.headers['host'] = [{ key: 'host', value: PRERENDER_HOST }];
  request.uri = '/' + targetUrl;
  request.querystring = '';

  return request;
}

exports.handler = async function (event) {
  var record = event.Records[0].cf;
  var eventType = record.config.eventType;
  var request = record.request;

  if (eventType === 'viewer-request') return handleViewerRequest(request);
  if (eventType === 'origin-request') return handleOriginRequest(request);
  return request;
};
