# CarModPicker Frontend Environment Variables
# Copy this file to .env and fill in your actual values

# API Configuration
# For local development, leave this empty to use the Vite dev server proxy
# For production deployment, set this to your backend URL
VITE_API_URL=

# --- Local dev: which backend to use (only applies when running npm run dev) ---
# Options: local (default) | staging | prod
# - local: use Vite proxy to http://localhost:8000 (no env needed)
# - staging: use VITE_STAGING_API_URL (set below)
# - prod: use VITE_PROD_API_URL (set below)
VITE_BACKEND=local

# Staging backend base URL (no trailing slash). Used when VITE_BACKEND=staging or npm run dev:staging
VITE_STAGING_API_URL=

# Production backend base URL (no trailing slash). Used when VITE_BACKEND=prod or npm run dev:prod
VITE_PROD_API_URL=

# Example values:
# Local development (using Vite proxy): VITE_API_URL= (leave empty)
# Railway deployment: VITE_API_URL=https://your-backend-app.railway.app
# Other hosting: VITE_API_URL=https://api.carmodpicker.webbpulse.com

# Note for Railway Deployment:
# 1. Deploy your backend first and get its Railway URL
# 2. Set VITE_API_URL to that backend URL as a build-time environment variable
# 3. Railway will inject this during the Docker build process

# Note for local dev against staging/prod:
# - Run: npm run dev:staging (or dev:prod), or set VITE_BACKEND=staging in .env and npm run dev
# - Set VITE_STAGING_API_URL / VITE_PROD_API_URL to your backend base URL (e.g. https://your-app.railway.app)
# - Backend must allow CORS from http://localhost:4000
