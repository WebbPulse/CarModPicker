[bandit]
# Bandit configuration for CarModPicker backend
# This file configures Bandit security scanner settings

# Exclude directories from scanning
exclude_dirs = 
    .venv,
    venv,
    __pycache__,
    .pytest_cache,
    .mypy_cache,
    alembic/versions

# Skip certain test IDs that are false positives in our use case
# B404: subprocess import - We use subprocess safely for migrations (marked with # nosec)
# B603: subprocess call - We use hardcoded commands, not user input (marked with # nosec)
# B607: partial path - We use pip-installed executables (alembic) (marked with # nosec)
# Note: Individual instances are suppressed with # nosec comments in code
# This global skip is a backup in case we add more subprocess usage
skips = B404,B603,B607
